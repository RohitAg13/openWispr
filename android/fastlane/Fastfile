# fastlane pipeline for OpenWispr (Google Play).
#
# Auth: the service-account JSON path comes from PLAY_JSON_KEY_FILE (set in the Appfile). Never
# commit the key. Locally: export PLAY_JSON_KEY_FILE=/path/to/play.json before running a lane.
#
# The very FIRST upload must be done by hand in the Play Console — Google only opens the API for a
# package after an app exists and one build has been uploaded manually. After that, these lanes work.

default_platform(:android)

DEFAULT_AAB = "app/build/outputs/bundle/release/app-release.aab".freeze

# The versionCode currently in the build file, as a string.
#
# Needed by `promote_production` to name the release it is promoting; see the comment there for
# why naming it is what makes the promote work at all. Read from the same file Gradle builds
# from, so the number cannot disagree with the binary that was uploaded from this commit.
def android_version_code
  file = "app/build.gradle.kts"
  code = File.read(file)[/^\s*versionCode\s*=\s*(\d+)/, 1]
  UI.user_error!("Couldn't read versionCode from #{file}") if code.nil?
  code
end

platform :android do
  desc "Validate the Play service-account key (auth smoke test)"
  lane :whoami do
    validate_play_store_json_key
  end

  desc "Build (if needed) and upload the release AAB to the internal testing track"
  lane :internal do
    aab = ENV["AAB_PATH"] # CI passes the already-built AAB to skip a rebuild
    if aab.nil? || aab.empty?
      gradle(task: "bundle", build_type: "Release")
      aab = lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH] || DEFAULT_AAB
    end
    upload_to_play_store(
      track: "internal",
      aab: aab,
      skip_upload_apk: true,
      release_status: "completed",
      # Store listing/screenshots are managed by the `metadata` lane, not on every binary upload.
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  # Staged by default. A promotion is the only step in this pipeline that reaches real users,
  # and it is one-way — Play has no rollback, only a halt and a higher versionCode. Shipping to
  # a fraction first means a bad build is haltable instead of universal. Override deliberately:
  #   fastlane promote_production rollout:1.0
  desc "Promote the current internal-track release to production (staged rollout)"
  lane :promote_production do |options|
    rollout = options.fetch(:rollout, "0.2").to_s
    full = rollout.to_f >= 1.0
    # Naming the versionCode is not a nicety — it is the fix for #58, which failed every staged
    # release from v1.1.0 to v1.6.0 with "Track 'internal' doesn't have any releases" while the
    # internal track demonstrably held the release (the diagnostic step in release.yml reads it
    # back seconds earlier, from its own edit).
    #
    # supply/lib/supply/uploader.rb, promote_track:
    #
    #     releases = track_from.releases
    #     if Supply.config[:version_code].to_s != ""
    #       releases = releases.select { |r| r.version_codes.include?(version_code.to_s) }
    #     else
    #       releases = releases.select { |r| r.status == Supply.config[:release_status] }
    #     end
    #     UI.user_error!("Track '...' doesn't have any releases") if releases.size == 0
    #
    # With no version_code it filters the *source* track by `release_status` — but
    # `release_status` is the status we want on the *destination*. The `internal` lane publishes
    # as "completed"; a staged promote asks for "inProgress"; nothing matches and supply reports
    # the source track as empty. That also explains why it only ever failed on staged rollouts:
    # `rollout:1.0` sets release_status to "completed", which happens to match the source.
    #
    # Passing version_code takes the other branch and skips the status filter entirely.
    version_code = options.fetch(:version_code, nil).to_s
    version_code = android_version_code if version_code.empty?
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      version_code: version_code,
      # "inProgress" is what makes a rollout staged; "completed" ignores the fraction and
      # goes to everyone, which is the trap this lane is trying to avoid.
      release_status: full ? "completed" : "inProgress",
      rollout: full ? nil : rollout,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      # The notes were already attached to this versionCode by the `internal` lane. Re-sending
      # them here is what makes supply hunt for a release that doesn't exist yet at promote time.
      skip_upload_changelogs: true,
    )
  end

  # `fastlane metadata validate_only:true` dry-runs against Play without publishing.
  desc "Push store listing text + images (no binary)"
  lane :metadata do |options|
    upload_to_play_store(
      validate_only: options.fetch(:validate_only, false).to_s == "true",
      skip_upload_apk: true,
      skip_upload_aab: true,
      # Release notes are keyed to a versionCode, so they ride along with the binary in
      # the `internal` lane. Uploading them here — with no release to attach them to —
      # makes supply fail with "Unable to find the requested release".
      skip_upload_changelogs: true,
    )
  end
end
